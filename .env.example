# Copy to .env (gitignored) if you want env-file based configuration.
# W&B: preferred setup is `uv run wandb login` (stores the key in ~/.netrc, outside the repo).
# If no credentials are found, the harness automatically falls back to WANDB_MODE=offline.
WANDB_API_KEY=
# Optional: relocate FiftyOne's mongodb data dir (defaults to ~/.fiftyone)
FIFTYONE_DATABASE_DIR=
